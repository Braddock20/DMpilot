# ---- Required ----
# Get one for free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Your phone number in international format, digits only.
# Example: 15551234567  (no + sign, no spaces)
PHONE_NUMBER=15551234567

# ---- Optional ----

# HTTP port for the /health endpoint. Render (as a web service) expects
# something to be listening on a port; this is what keeps the deploy healthy.
# On Render, leave it at 10000 (Render routes 10000 internally).
HEALTH_PORT=10000

# Gemini model. Default: gemini-1.5-flash (fast + free tier friendly)
GEMINI_MODEL=gemini-1.5-flash

# Personality / system prompt for the AI
SYSTEM_PROMPT=You are a helpful, friendly WhatsApp assistant. Keep replies short, conversational, and natural. Use the same language the user writes in.

# Reply behavior
#   "dm"      -> only reply to private 1:1 chats (default, safest)
#   "all"     -> reply to DMs AND groups
#   "groups"  -> only reply inside groups
REPLY_SCOPE=dm

# Should the bot reply in groups only when @mentioned? (true / false)
# Only relevant when REPLY_SCOPE=groups or all
GROUP_MENTION_ONLY=true

# Per-chat cooldown in seconds. Prevents spam and WhatsApp bans.
REPLY_COOLDOWN_SECONDS=60

# Max reply length in characters (Gemini will be told to keep replies under this)
MAX_REPLY_CHARS=800

# How many recent messages per chat to feed Gemini as conversation context
CONTEXT_WINDOW=6

# Owner JIDs (comma-separated) that ALWAYS trigger a reply, regardless of scope
# These are the only JIDs that can run commands (!grab, !grabviewonce, !ping, etc.)
# Example: 15551234567@s.whatsapp.net,447700900123@s.whatsapp.net
OWNER_JIDS=

# Optional: filter replies only to certain JIDs (comma-separated). Empty = no filter.
# Useful while testing so you don't auto-reply to strangers.
ALLOWED_JIDS=

# ---- Presence (autotyping / autorecording) -------------------------------
AUTO_TYPING=true
AUTO_RECORDING=false
# What the bot shows while generating a reply. Per-chat flavor is cached so each
# chat always sees the same one. Options: typing | recording | both
PRESENCE_MODE=typing

# ---- Autoreact -----------------------------------------------------------
AUTO_REACT=false
# Comma-separated emoji to randomly pick from
AUTO_REACT_EMOJIS=👍,❤️,🔥,😂,😮,😢,🙏,✨,🎉,💯,🤔,😅,🤝,🚀,💪
AUTO_REACT_ON_TEXT=true
AUTO_REACT_ON_MEDIA=true

# ---- !grab / !grabviewonce ----------------------------------------------
GRAB_ENABLED=true
GRAB_MAX_MESSAGES=100
GRAB_TEMP_DIR=/tmp/wa-grabs

# ---- Reconnect behavior (free-tier resilience) --------------------------
RECONNECT_MIN_MS=1000
RECONNECT_MAX_MS=10000
